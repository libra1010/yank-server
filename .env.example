# docker compose 读这一份（compose 自己会读同目录的 .env；先 cp .env.example .env 再填）。
#
# 这文件里不要留真口令：.env 是被 .gitignore 掉的，而 .env.example 是要提交、要公开的。
# 填了值就请把它当秘密对待 —— 尤其是 SYNCD_ADMIN_PASSWORD。

# 数据库。前缀挑方言，剩下的形状由驱动定（见 README「换数据库」那一节）：
#   sqlite    sqlite:///data/dropterm-sync.db          （默认，落在 syncd-data 卷里）
#   mysql     mysql://user:pw@tcp(host:3306)/db        （tcp(...) 不能省）
#   postgres  postgres://user:pw@host:5432/db?sslmode=disable
SYNCD_DSN=sqlite:///data/dropterm-sync.db

# 自助注册。0 = 关掉，POST /api/register 直接 403；已登录的会话与设备不受影响。
# 关掉之后加账号有两条路：先临时开一下再关，或者用下面两个变量在首次启动时建出来。
SYNCD_OPEN_SIGNUP=1

# 管理账号：只在"这个库里还没有这个账号"时建号，已存在的话一个字都不动 ——
# 页面上改过口令以后，重启不会悄悄把它换回这一串。账号名 3–64 个字符、不含空格。
# 建完号就把这两行删掉，以后改口令只在管理页面改。
SYNCD_ADMIN_USER=
SYNCD_ADMIN_PASSWORD=

# 镜像与构建源。换源不必改 Dockerfile：
#   MIRROR=          留空就回官方 Docker Hub（daemon.json 里配了 registry-mirrors 也照样生效）
#   GOPROXY=         默认 goproxy.cn，公司内有代理就指那里
#   IMAGE_TAG=       决定本地镜像叫 yank-syncd:<这个>
# Dockerfile（标准版）不读 MIRROR；要走官方源就 docker build -f Dockerfile。
MIRROR=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library
GOPROXY=https://goproxy.cn,direct
IMAGE_TAG=dev
